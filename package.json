{
  "name": "incident-replay-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && npm start",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0",
    "lucide-react": "^0.553.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
